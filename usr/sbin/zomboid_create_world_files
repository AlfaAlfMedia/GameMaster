#!/usr/bin/python3
"""Create the files of a new Project Zomboid world. Must be run as root.

Usage:
    zomboid_create_world_files [-u|--username USERNAME] WORLDNAME

WORLDNAME is used for the files and directories of the world and is also
written into the ini file as the name the players see. Without -u the
user PZ_DEFAULT_USER from /etc/gamemaster/gamemaster.conf is taken.
"""

import argparse
import os
import shutil
import sys
from pathlib import Path

from gamemaster import configfile, validate
from gamemaster.errors import GameMasterError

ETC_DIR = Path("/etc/gamemaster")
GAMEMASTER_CONF_FILE = ETC_DIR / "gamemaster.conf"
ZOMBOID_ETC_DIR = ETC_DIR / "zomboid"

SHARE_DIR = Path("/usr/share/gamemaster/zomboid")
INI_TEMPLATE = SHARE_DIR / "template.ini"
SANDBOX_TEMPLATE = SHARE_DIR / "template_SandboxVars.lua"

# The setting in the ini file that holds the name shown in the server browser
PUBLIC_NAME_KEY = "PublicName"

# Settings that are carried over from the configuration of the user into the
# ini file of the world: ini setting -> setting in the user's conf file
INI_FROM_CONF = {
    "RCONPassword": "PZ_SERVER_RCON_PASSWORD",
    "RCONPort": "PZ_RCON_PORT",
    "DefaultPort": "PZ_SERVER_PORT",
    "UDPPort": "PZ_UDP_PORT",
}

# Of those, the ones that have to be a port number
PORT_KEYS = ("RCONPort", "DefaultPort", "UDPPort")

# The server user and its group may read and write, nobody else. The ini file
# holds the RCON password, so it must not be readable for everyone.
FILE_MODE = 0o660
DIRECTORY_MODE = 0o770


def check_root() -> None:
    """End with an error if the program is not run as root."""
    if os.geteuid() != 0:
        raise GameMasterError(
            "This command must be run as root (for example with sudo)."
        )


def read_settings(path: Path) -> dict[str, str]:
    """Return the settings of a configuration file."""
    try:
        return configfile.read_values(path.read_text(encoding="utf-8"))
    except OSError as error:
        raise GameMasterError(f"Could not read {path}: {error}") from error


def read_template(path: Path) -> str:
    """Return the contents of a template file."""
    try:
        return path.read_text(encoding="utf-8")
    except OSError as error:
        raise GameMasterError(f"Could not read the template {path}: {error}") from error


def hand_over(path: Path, owner: str, mode: int) -> None:
    """Give path to owner and its group, and set the permissions."""
    try:
        shutil.chown(path, user=owner, group=owner)
        path.chmod(mode)
    except (OSError, LookupError) as error:
        raise GameMasterError(
            f"Could not set owner or permissions of {path}: {error}"
        ) from error


def create_file(path: Path, content: str, owner: str) -> None:
    """Write content to a file that must not exist yet, and hand it to owner."""
    try:
        # Mode 'x' creates the file and fails if it is already there, so an
        # existing world can never be overwritten
        with open(path, "x", encoding="utf-8") as new_file:
            new_file.write(content)
    except FileExistsError:
        raise GameMasterError(f"{path} already exists.") from None
    except OSError as error:
        raise GameMasterError(f"Could not write {path}: {error}") from error

    hand_over(path, owner, FILE_MODE)


def create_directory(path: Path, owner: str) -> None:
    """Create a directory that must not exist yet, and hand it to owner."""
    try:
        path.mkdir(parents=True)
    except FileExistsError:
        raise GameMasterError(f"{path} already exists.") from None
    except OSError as error:
        raise GameMasterError(f"Could not create {path}: {error}") from error

    hand_over(path, owner, DIRECTORY_MODE)


def build_ini(
    template: str, worldname: str, settings: dict[str, str], source: str
) -> str:
    """Return the ini file of the new world, filled in from the template."""
    content = configfile.set_value(template, PUBLIC_NAME_KEY, worldname)

    for ini_key, conf_key in INI_FROM_CONF.items():
        value = configfile.require(settings, conf_key, source)
        if ini_key in PORT_KEYS:
            # parse_port returns a number, which is turned back into text
            value = str(validate.parse_port(value, conf_key))
        content = configfile.set_value(content, ini_key, value)

    return content


def get_username(given: str | None) -> str:
    """Return the user name from the command line or from gamemaster.conf."""
    if given is not None:
        return validate.parse_username(given)

    settings = read_settings(GAMEMASTER_CONF_FILE)
    default = settings.get("PZ_DEFAULT_USER")
    if not default:
        raise GameMasterError(
            f"No user given and PZ_DEFAULT_USER is not set in "
            f"{GAMEMASTER_CONF_FILE}. Use -u/--username to name a user."
        )
    return validate.parse_username(default)


def create_world(given_username: str | None, given_worldname: str) -> None:
    """Create the ini file, the sandbox file and the save directory."""
    check_root()

    username = get_username(given_username)
    worldname = validate.parse_worldname(given_worldname)

    conf_file = ZOMBOID_ETC_DIR / f"{username}.conf"
    if not conf_file.is_file():
        raise GameMasterError(
            f"No configuration found for user '{username}': {conf_file}. "
            f"Run 'gamemaster add zomboid -u {username}' first."
        )

    settings = read_settings(conf_file)
    source = str(conf_file)
    data_dir = Path(configfile.require(settings, "PZ_SERVER_DATA_DIR", source))
    server_user = validate.parse_username(
        configfile.require(settings, "PZ_SERVER_USER", source)
    )

    ini_file = data_dir / "Server" / f"{worldname}.ini"
    sandbox_file = data_dir / "Server" / f"{worldname}_SandboxVars.lua"
    save_dir = data_dir / "Saves" / "Multiplayer" / worldname

    for path in (ini_file, sandbox_file, save_dir):
        if path.exists():
            raise GameMasterError(f"The world '{worldname}' already exists: {path}")

    ini_content = build_ini(read_template(INI_TEMPLATE), worldname, settings, source)
    sandbox_content = read_template(SANDBOX_TEMPLATE)

    create_file(ini_file, ini_content, server_user)
    create_file(sandbox_file, sandbox_content, server_user)
    create_directory(save_dir, server_user)

    print(f"Created the world '{worldname}' for user '{username}'.")
    print(f"Settings: {ini_file}")
    print(f"Sandbox:  {sandbox_file}")
    print(f"Savegame: {save_dir}")


def build_parser() -> argparse.ArgumentParser:
    """Describe the command line."""
    parser = argparse.ArgumentParser(
        prog="zomboid_create_world_files",
        description="Create the files of a new Project Zomboid world.",
    )
    parser.add_argument(
        "worldname",
        metavar="WORLDNAME",
        help="name of the new world, used for its files and as the name "
             "shown in the server browser",
    )
    parser.add_argument(
        "-u",
        "--username",
        metavar="USERNAME",
        default=None,
        help="user whose server the world belongs to "
             f"(default: PZ_DEFAULT_USER from {GAMEMASTER_CONF_FILE})",
    )
    return parser


def main() -> int:
    """Start of the program. Returns the exit code (0 = everything ok)."""
    arguments = build_parser().parse_args()

    try:
        create_world(arguments.username, arguments.worldname)
    except GameMasterError as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
