#!/usr/bin/python3
"""gamemaster - administration tool for GameMaster. Must be run as root.

Usage:
    gamemaster add GAME [-u|--username USERNAME] [-d|--installdir DIRECTORY]
                        [PORT OPTIONS]
    gamemaster install GAME [-u|--username USERNAME]
                            [-d|--installdir DIRECTORY]
                            [PORT OPTIONS] [-b|--beta BRANCH]
    gamemaster agent [-l|--list]
    gamemaster -h | --help

GAME is zomboid (Project Zomboid) or valheim (Valheim). The port options
are those of the game:

    zomboid   [-P|--port PORT] [-U|--udp-port PORT] [-R|--rcon-port PORT]
    valheim   [-P|--port PORT]

"add GAME" registers an EXISTING server with GameMaster. It does not
create the Linux user and it does not install the server. It writes the
file /etc/gamemaster/GAME/USERNAME.conf. Without -d the server is looked
for in the default directory, then in the home directory of the user and
two levels below it.

"install GAME" installs a server with SteamCMD and then registers it like
"add GAME". The Linux user is created if it does not exist; its password is
asked for. SteamCMD itself must already be installed.

The ports are taken from the template unless they are given. A port that
another server already uses, of whichever game, is refused; without the
matching option the program then offers the next free one.
"""

import argparse
import getpass
import grp
import pwd
import shutil
import subprocess
import sys
from collections.abc import Callable
from pathlib import Path
from typing import NamedTuple

from gamemaster import (
    configfile, context, permissions, sshkey, steamcmd, validate, valheim, zomboid,
)
from gamemaster.errors import GameMasterError

GAMEMASTER_CONF_FILE = context.GAMEMASTER_CONF_FILE

SHARE_DIR = Path("/usr/share/gamemaster")

LOGIN_SHELL = "/bin/bash"


# ---------------------------------------------------------------------------
# The games
# ---------------------------------------------------------------------------


class Port(NamedTuple):
    """One port setting of a game, and how it is given on the command line."""

    key: str
    short: str
    long: str
    help: str
    # How many ports from this one upwards the server opens
    count: int = 1

    @property
    def dest(self) -> str:
        """Return the name argparse stores the option under."""
        return self.long.lstrip("-").replace("-", "_")


class Game(NamedTuple):
    """What 'add' and 'install' need to know about one game."""

    name: str
    title: str
    # Prefix of its settings, as PZ in PZ_DEFAULT_USER
    prefix: str
    # A file that is there in every installed server
    server_file: str
    ports: tuple[Port, ...]
    fix_permissions: Callable[[str], tuple[Path, permissions.Report | None]]
    # Printed at the end of a successful install
    next_steps: str

    @property
    def etc_dir(self) -> Path:
        """Return the directory of the configuration files of its servers."""
        return context.ETC_DIR / self.name

    @property
    def template_file(self) -> Path:
        """Return the template of the configuration of a server."""
        return SHARE_DIR / self.name / "template.conf"

    def key(self, name: str) -> str:
        """Return the full name of one of its settings."""
        return f"{self.prefix}_{name}"


def fix_zomboid(username: str) -> tuple[Path, permissions.Report | None]:
    """Sort the data directory of a registered Zomboid server."""
    server = zomboid.load(username)
    return server.data_dir, zomboid.fix_permissions(server)


def fix_valheim(username: str) -> tuple[Path, permissions.Report | None]:
    """Sort the data directory of a registered Valheim server."""
    server = valheim.load(username)
    return server.data_dir, valheim.fix_permissions(server)


GAMES = {
    "zomboid": Game(
        name="zomboid",
        title="Project Zomboid",
        prefix="PZ",
        server_file="start-server.sh",
        ports=(
            Port("PZ_SERVER_PORT", "-P", "--port", "udp port the players connect to"),
            Port("PZ_UDP_PORT", "-U", "--udp-port", "second udp port of the server"),
            Port("PZ_RCON_PORT", "-R", "--rcon-port", "port of the remote console"),
        ),
        fix_permissions=fix_zomboid,
        next_steps=(
            "The passwords in {conf_file} are still the ones from the template. "
            "Change them before creating the first world."
        ),
    ),
    "valheim": Game(
        name="valheim",
        title="Valheim",
        prefix="VH",
        server_file="valheim_server.x86_64",
        ports=(
            Port(
                "VH_SERVER_PORT", "-P", "--port",
                "udp port the players connect to; the next one is used as well",
                count=2,
            ),
        ),
        fix_permissions=fix_valheim,
        next_steps=(
            "The name and the password in {conf_file} are still the ones from "
            "the template. Change them, then create the first world: "
            "valheim -u {username} world create NAME"
        ),
    ),
}


# ---------------------------------------------------------------------------
# Users and directories
# ---------------------------------------------------------------------------


def user_exists(username: str) -> bool:
    """Say whether the Linux user exists."""
    try:
        pwd.getpwnam(username)
    except KeyError:
        return False
    return True


def check_username(game: Game, username: str) -> str:
    """Return the name of an existing Linux user."""
    # The form is checked by the library, the existence by the system
    username = validate.parse_username(username)
    if not user_exists(username):
        raise GameMasterError(
            f"The Linux user '{username}' does not exist. "
            f"'gamemaster install {game.name}' creates the user and installs "
            f"the server."
        )
    return username


def has_server(game: Game, install_dir: str) -> bool:
    """Say whether a server of the game is installed in the directory."""
    return (Path(install_dir) / game.server_file).is_file()


def check_install_dir(game: Game, install_dir: str) -> str:
    """Return the directory of an installed server of the game."""
    install_dir = validate.parse_install_dir(install_dir)
    if not has_server(game, install_dir):
        raise GameMasterError(
            f"No {game.title} server found in {install_dir} "
            f"({game.server_file} is missing)."
        )
    return install_dir


def find_install_dir(game: Game, default: str, home: Path) -> str:
    """Return the directory of the one installed server to be found.

    First the default directory of the template, then the home directory
    of the server user and two levels below it. More than one server, or
    none, is an error that says what to do instead.
    """
    if has_server(game, default):
        return default

    patterns = (game.server_file, f"*/{game.server_file}", f"*/*/{game.server_file}")
    found = sorted({
        str(script.parent)
        for pattern in patterns
        for script in home.glob(pattern)
        if script.is_file()
    })

    if len(found) == 1:
        print(f"Found the {game.title} server in {found[0]}.")
        return found[0]

    if found:
        raise GameMasterError(
            f"There is more than one {game.title} server below {home}: "
            f"{', '.join(found)}. Use -d/--installdir to name the one to register."
        )

    raise GameMasterError(
        f"No {game.title} server found in {default} or below {home}. "
        f"Use -d/--installdir to name its directory, or 'gamemaster install "
        f"{game.name}' to install one."
    )


def get_default_username(game: Game, settings: dict[str, str]) -> str:
    """Return the default user of the game from /etc/gamemaster/gamemaster.conf."""
    key = game.key("DEFAULT_USER")
    username = settings.get(key)
    if not username:
        raise GameMasterError(
            f"No user given and {key} is not set in "
            f"{GAMEMASTER_CONF_FILE}. Use -u/--username to name a user."
        )
    return username


def get_setting(settings: dict[str, str], key: str) -> str:
    """Return a setting from /etc/gamemaster/gamemaster.conf that must be there."""
    return configfile.require(settings, key, str(GAMEMASTER_CONF_FILE))


def get_default_install_dir(game: Game, template: str) -> str:
    """Return the install directory from the template."""
    return configfile.require(
        configfile.read_values(template),
        game.key("SERVER_INSTALL_DIR"),
        str(game.template_file),
    )


def fix_data_dir(game: Game, username: str) -> None:
    """Give the files of the server to its user, sorted the GameMaster way.

    The worlds and the logs of a server live below its home directory, and
    the agent works on them as a member of that user's group. A server that
    was set up by hand, or files that were copied in, would otherwise keep
    whatever owner and permissions they happened to get. This also opens
    the home directory to the group, without which nothing below it could
    be reached.
    """
    data_dir, result = game.fix_permissions(username)

    if result is None:
        print(f"{data_dir} does not exist yet; the first world creates it.")
        return

    print(f"Permissions of {data_dir}: {result.changed} changed.")
    for skipped in result.skipped:
        print(f"  left alone: {skipped.path} ({skipped.reason})")


def add_user_to_group(username: str, group: str) -> None:
    """Put the user into the group, unless it is a member already."""
    if username in grp.getgrnam(group).gr_mem:
        return

    try:
        subprocess.run(["usermod", "-aG", group, username], check=True)
    except (OSError, subprocess.CalledProcessError) as error:
        raise GameMasterError(
            f"Could not add '{username}' to the group '{group}': {error}"
        ) from error

    print(f"Added the user '{username}' to the group '{group}'.")


def get_agent_user(settings: dict[str, str]) -> str:
    """Return GM_AGENT_USER, the user an AI agent connects as."""
    return validate.parse_username(get_setting(settings, "GM_AGENT_USER"))


def add_agent_to_group(username: str, agent: str) -> None:
    """Put the agent user into the group of the server user."""
    # As a member of the group of the server user, the agent may read the
    # files of that server

    if not user_exists(agent):
        print(
            f"Note: the user '{agent}' does not exist, so it was not added to "
            f"the group '{username}'.",
            file=sys.stderr,
        )
        return

    add_user_to_group(agent, username)


# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------


def used_ports(etc_dir: Path = context.ETC_DIR) -> dict[int, str]:
    """Return every port that is taken, by a server of any game, with its owner."""
    taken: dict[int, str] = {}

    for game in GAMES.values():
        directory = etc_dir / game.name
        if not directory.is_dir():
            continue

        for conf_file in sorted(directory.glob("*.conf")):
            settings = context.read_settings(conf_file)
            owner = f"{conf_file.stem} ({game.name})"
            for port in game.ports:
                value = settings.get(port.key, "")
                if not value.isdigit():
                    continue
                for number in range(int(value), int(value) + port.count):
                    taken.setdefault(number, owner)

    return taken


def collision(port: int, count: int, taken: dict[int, str]) -> int | None:
    """Return the first of the ports from port upwards that is taken, or None."""
    for number in range(port, port + count):
        if number in taken:
            return number
    return None


def next_free_port(after: int, count: int, taken: dict[int, str]) -> int:
    """Return the first port from this one upwards with count free ports."""
    port = after
    while collision(port, count, taken) is not None:
        port += 1
    if port + count - 1 > validate.MAXIMUM_PORT:
        raise GameMasterError("No free port left.")
    return port


def check_free(port: int, count: int, taken: dict[int, str]) -> None:
    """Raise if one of the ports from port upwards is taken."""
    if port + count - 1 > validate.MAXIMUM_PORT:
        raise GameMasterError(
            f"Port {port} is too high: the server also needs the "
            f"{count - 1} after it."
        )
    used = collision(port, count, taken)
    if used is not None:
        raise GameMasterError(f"Port {used} is already used by '{taken[used]}'.")


def ask_for_port(setting: Port, suggestion: int, taken: dict[int, str]) -> int:
    """Ask the administrator for a port, offering the suggestion."""
    while True:
        answer = input(f"{setting.key}: port for this server [{suggestion}]: ").strip()
        if not answer:
            return suggestion
        try:
            port = validate.parse_port(answer, setting.key)
            check_free(port, setting.count, taken)
        except GameMasterError as error:
            print(error, file=sys.stderr)
            continue
        return port


def choose_port(
    setting: Port, given: str | None, default: str, taken: dict[int, str]
) -> int:
    """Return the port for one setting: from the option, the template or a dialog."""
    if given is not None:
        port = validate.parse_port(given, setting.key)
        check_free(port, setting.count, taken)
        return port

    port = validate.parse_port(default, setting.key)
    used = collision(port, setting.count, taken)
    if used is None:
        return port

    suggestion = next_free_port(port + 1, setting.count, taken)

    if not sys.stdin.isatty():
        raise GameMasterError(
            f"Port {used} from the template is already used by '{taken[used]}'. "
            f"Use {setting.long} to choose one, for example {suggestion}."
        )

    print(f"Port {used} is already used by '{taken[used]}'.")
    return ask_for_port(setting, suggestion, taken)


def choose_ports(
    game: Game, template: str, arguments: argparse.Namespace
) -> dict[str, int]:
    """Return a port for every port setting of the game, free of collisions."""
    defaults = configfile.read_values(template)
    taken = used_ports()
    chosen: dict[str, int] = {}

    for setting in game.ports:
        port = choose_port(
            setting,
            getattr(arguments, setting.dest),
            configfile.require(defaults, setting.key, str(game.template_file)),
            taken,
        )
        # A port chosen now must not be offered again in this same run
        for number in range(port, port + setting.count):
            taken[number] = "this server"
        chosen[setting.key] = port

    return chosen


# ---------------------------------------------------------------------------
# Writing the configuration
# ---------------------------------------------------------------------------


def check_not_registered(game: Game, username: str) -> None:
    """End with an error if the user has a configuration file already."""
    conf_file = game.etc_dir / f"{username}.conf"
    if conf_file.exists():
        raise GameMasterError(
            f"{conf_file} already exists. The user '{username}' is already "
            f"registered for {game.title}."
        )


def write_config(
    game: Game,
    template: str,
    username: str,
    install_dir: str,
    branch: str,
    ports: dict[str, int],
) -> Path:
    """Create /etc/gamemaster/GAME/USERNAME.conf from the template."""
    conf_file = game.etc_dir / f"{username}.conf"

    content = configfile.set_value(template, game.key("SERVER_INSTALL_DIR"), install_dir)
    content = configfile.set_value(content, game.key("SERVER_USER"), username)
    content = configfile.set_value(content, game.key("SERVER_BRANCH"), branch)
    for key, port in ports.items():
        content = configfile.set_value(content, key, str(port))

    try:
        game.etc_dir.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        raise GameMasterError(f"Could not create {game.etc_dir}: {error}") from error

    # Mode 'x' creates the file and fails if it already exists
    try:
        with open(conf_file, "x", encoding="utf-8") as new_file:
            new_file.write(content)
    except FileExistsError:
        raise GameMasterError(
            f"{conf_file} already exists. The user '{username}' is already registered."
        ) from None
    except OSError as error:
        raise GameMasterError(f"Could not write {conf_file}: {error}") from error

    try:
        conf_file.chmod(0o600)
    except OSError as error:
        raise GameMasterError(
            f"Could not set the permissions of {conf_file}: {error}"
        ) from error

    print(f"Registered the {game.title} server of user '{username}'.")
    print(f"Configuration file: {conf_file}")
    for key, port in ports.items():
        print(f"  {key}={port}")

    return conf_file


def register(
    game: Game,
    agent: str,
    template: str,
    username: str,
    install_dir: str,
    branch: str,
    ports: dict[str, int],
) -> Path:
    """Write the configuration of the server and let the agent read its files."""
    conf_file = write_config(game, template, username, install_dir, branch, ports)
    fix_data_dir(game, username)
    add_agent_to_group(username, agent)
    return conf_file


# ---------------------------------------------------------------------------
# Installing
# ---------------------------------------------------------------------------


def check_install_target(
    game: Game, install_dir: str, username: str, exists: bool
) -> None:
    """End with an error if the server cannot be installed into the directory."""
    if has_server(game, install_dir):
        raise GameMasterError(
            f"There is a {game.title} server in {install_dir} already. "
            f"Use 'gamemaster add {game.name}' to register it."
        )

    directory = Path(install_dir)
    if not directory.exists():
        return

    if not directory.is_dir():
        raise GameMasterError(f"{install_dir} exists and is not a directory.")

    owner = pwd.getpwuid(directory.stat().st_uid).pw_name
    if not exists or owner != username:
        raise GameMasterError(
            f"{install_dir} already exists and belongs to '{owner}'. "
            f"Use -d/--installdir to choose another directory."
        )


def ask_for_password(username: str) -> str:
    """Ask twice for the password of a new user and return it."""
    if not sys.stdin.isatty():
        raise GameMasterError(
            f"The user '{username}' does not exist and has to be created, "
            f"which needs a password. Run the command in a terminal."
        )

    while True:
        password = getpass.getpass(f"Password for the new user '{username}': ")
        if not password:
            print("The password must not be empty.", file=sys.stderr)
            continue
        if password != getpass.getpass("Repeat the password: "):
            print("The passwords do not match.", file=sys.stderr)
            continue
        return password


def create_user(username: str, password: str) -> None:
    """Create the Linux user with a home directory and a group of its own."""
    try:
        subprocess.run(
            [
                "useradd",
                "--create-home",
                "--user-group",
                "--shell", LOGIN_SHELL,
                username,
            ],
            check=True,
        )
    except (OSError, subprocess.CalledProcessError) as error:
        raise GameMasterError(f"Could not create the user '{username}': {error}") from error

    # chpasswd reads the password from standard input, so it never shows up
    # in the list of processes
    try:
        subprocess.run(
            ["chpasswd"], input=f"{username}:{password}\n", text=True, check=True
        )
    except (OSError, subprocess.CalledProcessError) as error:
        raise GameMasterError(
            f"Could not set the password of '{username}': {error}"
        ) from error

    print(f"Created the user '{username}'.")


def prepare_install_dir(install_dir: str, username: str) -> None:
    """Create the install directory and hand it to the server user."""
    directory = Path(install_dir)
    try:
        directory.mkdir(parents=True, exist_ok=True)
        shutil.chown(directory, user=username, group=username)
        directory.chmod(0o755)
    except (OSError, LookupError) as error:
        raise GameMasterError(f"Could not prepare {install_dir}: {error}") from error


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------


def add_server(game: Game, arguments: argparse.Namespace) -> None:
    """gamemaster add GAME [options]"""
    settings = context.read_settings(GAMEMASTER_CONF_FILE)
    template = context.read_template(game.template_file)
    username = check_username(
        game, arguments.username or get_default_username(game, settings)
    )
    check_not_registered(game, username)
    install_dir = check_install_dir(
        game,
        arguments.installdir
        or find_install_dir(
            game,
            get_default_install_dir(game, template),
            Path(pwd.getpwnam(username).pw_dir),
        ),
    )
    branch = validate.parse_branch(get_setting(settings, game.key("DEFAULT_BRANCH")))
    agent = get_agent_user(settings)

    ports = choose_ports(game, template, arguments)

    register(game, agent, template, username, install_dir, branch, ports)


def install_server(game: Game, arguments: argparse.Namespace) -> None:
    """gamemaster install GAME [options]"""
    settings = context.read_settings(GAMEMASTER_CONF_FILE)
    template = context.read_template(game.template_file)
    username = validate.parse_username(
        arguments.username or get_default_username(game, settings)
    )
    install_dir = validate.parse_install_dir(
        arguments.installdir or get_default_install_dir(game, template)
    )
    app_id = validate.parse_app_id(get_setting(settings, game.key("APP_ID")))
    branch = validate.parse_branch(
        arguments.beta or get_setting(settings, game.key("DEFAULT_BRANCH"))
    )
    agent = get_agent_user(settings)

    # Before anything is created: without SteamCMD nothing can be installed
    steamcmd.find()
    check_not_registered(game, username)
    exists = user_exists(username)
    check_install_target(game, install_dir, username, exists)

    ports = choose_ports(game, template, arguments)

    if not exists:
        create_user(username, ask_for_password(username))

    prepare_install_dir(install_dir, username)

    print(f"Installing the {game.title} server into {install_dir} "
          f"(branch '{branch}') ...", flush=True)
    steamcmd.update(app_id, username, install_dir, branch)

    # SteamCMD does not always report a failed download in its exit code
    if not has_server(game, install_dir):
        raise GameMasterError(
            f"SteamCMD finished, but there is no {game.server_file} in "
            f"{install_dir}."
        )

    conf_file = register(game, agent, template, username, install_dir, branch, ports)

    print(game.next_steps.format(conf_file=conf_file, username=username))


# ---------------------------------------------------------------------------
# Command line
# ---------------------------------------------------------------------------


def add_server_options(parser: argparse.ArgumentParser, game: Game) -> None:
    """Add the options that describe a server of the game."""
    parser.add_argument(
        "-u",
        "--username",
        metavar="USERNAME",
        default=None,
        help=f"Linux user that runs the server "
             f"(default: {game.key('DEFAULT_USER')} from {GAMEMASTER_CONF_FILE})",
    )
    parser.add_argument(
        "-d",
        "--installdir",
        metavar="DIRECTORY",
        default=None,
        help=f"directory of the server (default: {game.key('SERVER_INSTALL_DIR')} "
             f"from {game.template_file}; 'add' also looks in the home of the user)",
    )
    for port in game.ports:
        parser.add_argument(
            port.short,
            port.long,
            dest=port.dest,
            metavar="PORT",
            default=None,
            help=f"{port.help} (default: from the template)",
        )


# ---------------------------------------------------------------------------
# The agent user
# ---------------------------------------------------------------------------


def show_agent_keys(agent: str) -> list[sshkey.PublicKey]:
    """List the keys that may log in as the agent user, and return them."""
    keys = sshkey.read_keys(agent)
    path = sshkey.authorized_keys_file(agent)

    print(f"Agent user:      {agent}")
    print(f"Keys are kept in {path}")

    if not keys:
        print("There is no key yet, so the agent cannot log in.")
        return keys

    print(f"\n{len(keys)} key(s) may log in as '{agent}':")
    for number, key in enumerate(keys, start=1):
        comment = key.comment or "(no comment)"
        print(f"  {number}) {key.type:<12} {key.fingerprint}  {comment}")

    return keys


def ask_for_key() -> sshkey.PublicKey | None:
    """Ask for a public key and return it, or None if none was given."""
    print(
        "\nPaste the public key of the agent - one line, as it stands in its "
        ".pub file.\nLeave empty to add nothing."
    )

    while True:
        text = input("Key: ").strip()
        if not text:
            return None
        try:
            return sshkey.parse(text)
        except sshkey.SshKeyError as error:
            print(f"That is not a usable key: {error}")


def agent(arguments: argparse.Namespace) -> None:
    """gamemaster agent [--list]"""
    settings = context.read_settings(GAMEMASTER_CONF_FILE)
    name = get_agent_user(settings)

    try:
        pwd.getpwnam(name)
    except KeyError:
        raise GameMasterError(
            f"The agent user '{name}' does not exist. The GameMaster package "
            f"creates it; check {GAMEMASTER_CONF_FILE} if it is named "
            f"differently here."
        ) from None

    show_agent_keys(name)

    if arguments.list_only:
        return

    if not sys.stdin.isatty():
        print("\nNo terminal, so no key is asked for.")
        return

    answer = input("\nIs the key of the agent among them? [y/N] ").strip().lower()
    if answer in ("y", "yes", "j", "ja"):
        return

    key = ask_for_key()
    if key is None:
        print("Nothing added.")
        return

    path = sshkey.add_key(name, key)
    print(f"Added {key.fingerprint} to {path}")
    print(f"The agent can now log in as '{name}' with that key.")


def build_parser() -> argparse.ArgumentParser:
    """Describe the command line: commands, games, options."""
    parser = context.ArgumentParser(
        prog="gamemaster",
        description="Administration tool for GameMaster.",
    )
    commands = parser.add_subparsers(dest="command", required=True, metavar="COMMAND")

    add_parser = commands.add_parser("add", help="register an existing game server")
    add_games = add_parser.add_subparsers(dest="game", required=True, metavar="GAME")
    for game in GAMES.values():
        add_server_options(
            add_games.add_parser(game.name, help=f"register a {game.title} server"),
            game,
        )

    install_parser = commands.add_parser(
        "install", help="install a game server and register it"
    )
    install_games = install_parser.add_subparsers(
        dest="game", required=True, metavar="GAME"
    )
    for game in GAMES.values():
        game_parser = install_games.add_parser(
            game.name, help=f"install a {game.title} server"
        )
        add_server_options(game_parser, game)
        game_parser.add_argument(
            "-b",
            "--beta",
            metavar="BRANCH",
            default=None,
            help=f"install this beta branch "
                 f"(default: {game.key('DEFAULT_BRANCH')} from {GAMEMASTER_CONF_FILE})",
        )

    agent_parser = commands.add_parser(
        "agent", help="the keys the agent user may log in with"
    )
    agent_parser.add_argument(
        "-l",
        "--list",
        dest="list_only",
        action="store_true",
        help="only show the keys, do not ask for one",
    )

    return parser


def main() -> int:
    """Start of the program. Returns the exit code (0 = everything ok)."""
    arguments = build_parser().parse_args()

    def carry_out() -> None:
        context.require_root()
        if arguments.command == "add":
            add_server(GAMES[arguments.game], arguments)
        elif arguments.command == "install":
            install_server(GAMES[arguments.game], arguments)
        elif arguments.command == "agent":
            agent(arguments)

    return context.run(carry_out)


if __name__ == "__main__":
    sys.exit(main())
