# Template for the systemd service of one Project Zomboid server.
# Written by 'zomboid world init'. Do not edit a generated unit by hand -
# 'zomboid world switch' writes it again.

[Unit]
Description=Project Zomboid Dedicated Server (@USER@, world @WORLD@)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@INSTALL_DIR@

# Fetch a new version of the server before it starts.
#   +  run this as root, not as the server user: it reads the settings of
#      the server, which only root may read
#   -  a failed update must not keep the server from starting
ExecStartPre=-+/usr/sbin/zomboid -u @CONF_USER@ update

ExecStart=@INSTALL_DIR@/start-server.sh -servername @WORLD@

# The server is stopped over RCON, which saves the world first. Systemd
# only has to wait for it; it must not start it again by itself.
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=180

# SteamCMD may take a long time, and that time counts towards the start
TimeoutStartSec=1800

StandardOutput=append:@LOG_FILE@
StandardError=append:@LOG_FILE@

[Install]
WantedBy=multi-user.target
