# The systemd service of the Project Zomboid server of user @CONF_USER@.
# Written by GameMaster ('zomboid world init', 'zomboid world switch',
# 'zomboid service'), which replace it every time - do not edit it by hand.
# Commands of your own go into /etc/gamemaster/zomboid/@CONF_USER@.conf.

[Unit]
Description=Project Zomboid Dedicated Server (@USER@, world @WORLD@)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@INSTALL_DIR@

# Whatever the server creates may be read by its group, and changed where
# the group is allowed to; files the agent must not see are closed again
# by fix-permissions before the next start
UMask=0007

# Before the server starts: give its files back to it, then fetch a new
# version of the server.
#   +  run this as root, not as the server user: fix-permissions changes the
#      owner of files, and update reads the settings of the server, which
#      only root may read
#   -  neither may keep the server from starting when it fails
ExecStartPre=-+/usr/sbin/zomboid -u @CONF_USER@ fix-permissions
ExecStartPre=-+/usr/sbin/zomboid -u @CONF_USER@ update

# Commands the administrator added in the configuration of this server
# (PZ_EXEC_START_PRE_1 and so on). 'zomboid service' writes them in again.
@HOOKS@

ExecStart=@INSTALL_DIR@/start-server.sh -servername @WORLD@

# 'zomboid stop' stops the server over RCON, which saves the world first.
# Systemd only has to wait for it; it must not start it again by itself.
Restart=no

# When systemd stops the server itself - 'systemctl stop', or the machine
# shutting down - it sends SIGINT, the signal of Ctrl+C in a terminal, on
# which the server saves the world and shuts down. After three minutes it
# is killed.
KillSignal=SIGINT
TimeoutStopSec=180

# SteamCMD may take a long time, and that time counts towards the start
TimeoutStartSec=1800

StandardOutput=append:@LOG_FILE@
StandardError=append:@LOG_FILE@

[Install]
WantedBy=multi-user.target
