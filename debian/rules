#!/usr/bin/make -f

%:
	dh $@

# The sudoers file is only read when nobody but root may change it
override_dh_fixperms:
	dh_fixperms
	chmod 0440 debian/gamemaster/etc/sudoers.d/gamemaster

# SOUL.md and the skills are meant to be copied to an agent, so they must
# stay readable and not end up as gzip files
override_dh_compress:
	dh_compress -X SOUL.md -X SKILL.md
