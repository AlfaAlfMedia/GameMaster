#!/bin/sh
# Prepare what every GameMaster program expects to find.
set -e

AGENT_USER=gamemaster
AGENT_HOME=/var/lib/gamemaster

case "$1" in
    configure)
        # The user an AI agent connects as. It needs a shell and a home of
        # its own, because its key goes into ~/.ssh/authorized_keys.
        if ! getent passwd "$AGENT_USER" >/dev/null; then
            adduser --system --group \
                    --home "$AGENT_HOME" \
                    --shell /bin/bash \
                    --gecos "GameMaster agent" \
                    "$AGENT_USER"
        fi

        # What the agent creates in the directory of a server must be
        # usable by the server's group. pam_umask takes the umask of a
        # login from the GECOS field; an umask set there already is kept.
        gecos=$(getent passwd "$AGENT_USER" | cut -d: -f5)
        case ",$gecos," in
            *,umask=*) ;;
            *) usermod --comment "${gecos:+$gecos,}umask=0007" "$AGENT_USER" ;;
        esac
        ;;
esac

#DEBHELPER#

exit 0
